#!/usr/bin/env bash
#
# git-credential-scm-oauth: guard in front of git-credential-oauth (helper = scm-oauth, second in
# the scm-auth chain after git-credential-scm). git only gets here when the keyring had no usable
# token; git-credential-oauth then opens a browser tab and waits for the login. For background
# callers (IDE fetches, mise, cron, systemd units) nobody is there to finish it, so every such call
# leaves another stray tab. This guard runs the OAuth flow only for an interactive git (a controlling
# terminal and GIT_TERMINAL_PROMPT not 0), otherwise it answers nothing and git fails as without
# credentials. Each skip is logged (host and calling process, never a secret) to stderr and to the
# journal (tag scm-auth), so the callers that miss the keyring can be found.
#
# Secret-handling script: the request may carry an oauth_refresh_token, so it never traces.
#

set +x
unset BASH_XTRACEFD

function usage() {
    cat <<'EOF'
Usage: git-credential-scm-oauth [git-credential-oauth options] <get|store|erase>

git credential helper (helper = scm-oauth) that runs git-credential-oauth only when git is
interactive, so background processes never open browser tabs. store/erase are passed through.

Environment:
  SCM_AUTH_OAUTH  tty     (default) OAuth only with a controlling terminal and GIT_TERMINAL_PROMPT != 0
                  always  always run git-credential-oauth (old behaviour)
                  device  like tty, but print a device code instead of opening a browser
                  never   never run it; add tokens with scm-auth-login
  SCM_AUTH_OAUTH_BIN  git-credential-oauth binary (default: from PATH)
EOF
}

set -Eeuo pipefail
shopt -s inherit_errexit nullglob

function log() { printf '%s git-credential-scm-oauth: %s\n' "$(date -Iseconds)" "$*" >&2; }

# true when a user can answer: git allows prompts and the process has a controlling terminal
function interactive() {
    [[ "${GIT_TERMINAL_PROMPT:-1}" != 0 ]] || return 1
    { : </dev/tty; } 2>/dev/null
}

# '<comm>[<pid>]' of the process that ran git (git itself is usually our parent)
function caller() {
    local pid="$PPID" comm="" i
    for ((i = 0; i < 4; i++)); do
        comm="$(ps -o comm= -p "$pid" 2>/dev/null || true)"
        [[ "$comm" == git || "$comm" == git-* || "$comm" == sh || "$comm" == bash ]] || break
        pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
        [[ "$pid" =~ ^[0-9]+$ && "$pid" != 0 ]] || break
    done
    printf '%s[%s]\n' "${comm:-?}" "$pid"
}

function main() {
    local action="${*: -1}" mode="${SCM_AUTH_OAUTH:-tty}" oauth request="" line host="" proto="" message
    local -a opts=()
    case "$action" in
    -h | --help | '')
        usage
        [[ -n "$action" ]]
        return
        ;;
    esac
    (( $# > 1 )) && opts=("${@:1:$#-1}")
    oauth="${SCM_AUTH_OAUTH_BIN:-$(command -v git-credential-oauth || true)}"
    if [[ -z "$oauth" || ! -x "$oauth" ]]; then
        cat >/dev/null
        return 0
    fi
    [[ "$action" == get ]] || exec "$oauth" "${opts[@]}" "$action"

    # bounded read of git's request (key=value lines up to the blank line)
    while IFS= read -r line && [[ -n "$line" ]]; do
        (( ${#request} < 65536 )) || { log 'credential request too large'; return 1; }
        request+="$line"$'\n'
        case "$line" in
        host=*) host="${line#host=}" ;;
        protocol=*) proto="${line#protocol=}" ;;
        esac
    done
    case "$mode" in
    always) ;;
    tty | device)
        if ! interactive; then
            message="no keyring token for ${proto:-?}://${host:-?}; not starting the OAuth browser flow for non-interactive caller $(caller) (SCM_AUTH_OAUTH=always overrides; or: scm-auth-login --store-token ${host:-<host>})"
            log "$message"
            command -v logger &>/dev/null && logger -t scm-auth -p user.notice -- "$message" 2>/dev/null || true
            return 0
        fi
        [[ "$mode" == tty ]] || opts=(-device "${opts[@]}")
        ;;
    never) return 0 ;;
    *)
        log "invalid SCM_AUTH_OAUTH '$mode' (expected tty, always, device or never)"
        return 2
        ;;
    esac
    printf '%s\n' "$request" | "$oauth" "${opts[@]}" get
}

main "$@"
