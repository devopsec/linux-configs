#!/usr/bin/env bash
#
# git-credential-token: prints the HTTPS token git keeps for <host> in the login keyring, so other
# tools (forge --token-cmd, the hf shim) share the single git-credential-scm entry. stdout is the
# token only; nothing secret ever reaches stderr, argv or the environment of child processes.
#
# Secret-handling script: it never traces. DEBUG is ignored on purpose, and xtrace inherited
# through SHELLOPTS (or 'bash -x') is switched off before anything else runs, because xtrace
# would print the token to stderr (and stderr of a forge --token-cmd may end up in logs).
#

set +x
unset BASH_XTRACEFD GIT_TRACE GIT_TRACE2 GIT_TRACE2_EVENT GIT_TRACE2_PERF GIT_TRACE_CURL GIT_CURL_VERBOSE

function usage() {
    cat <<'EOF'
Usage: git-credential-token <host> [username]

Print the password/token stored for https://<host> by the git credential helper
(git-credential-scm) on stdout, without a trailing message. Exits 1 with no output when nothing
is stored.
Never prompts and never starts the git-credential-oauth browser flow.

  host        bare hostname, e.g. github.com
  username    optional username to select the entry (e.g. oauth2, hf)
  -h, --help  show this help

Environment:
  SCM_AUTH_TOOL               calling tool recorded by the helper (--tool=<name>; [a-z0-9_-],
                              1-32 chars; default git), e.g. forge or hf
  SCM_AUTH_CREDENTIAL_HELPER  helper to query instead of 'scm --tool=<tool>' (tests only, e.g.
                              'store --file /tmp/creds')
EOF
}

set -Eeuo pipefail
shopt -s inherit_errexit nullglob

function log() { printf '%s git-credential-token: %s\n' "$(date -Iseconds)" "$*" >&2; }

# git helper string for git-credential-scm: the absolute path of the copy installed next to this
# script (or on PATH) when it is shell-safe, since forge runs token-cmd with a minimal PATH that
# misses ~/.local/bin; else the bare 'scm' name git resolves through its exec-path and PATH
function scm_helper() {
    local tool="$1" candidate
    candidate="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/git-credential-scm"
    [[ -x "$candidate" ]] || candidate="$(command -v git-credential-scm || true)"
    if [[ "$candidate" =~ ^/[A-Za-z0-9._/+-]+$ && -x "$candidate" ]]; then
        printf '%s --tool=%s\n' "$candidate" "$tool"
    else
        printf 'scm --tool=%s\n' "$tool"
    fi
}

function main() {
    local host="" user="" tool="${SCM_AUTH_TOOL:-git}" helper="" request="" token=""
    case "${1:-}" in
    -h | --help)
        usage
        return 0
        ;;
    esac
    if (( $# < 1 || $# > 2 )); then
        usage >&2
        return 2
    fi
    host="$1"
    user="${2:-}"
    # allowlists keep the credential protocol free of injected lines/keys
    [[ "$host" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] || { log "invalid host: '$host'"; return 2; }
    [[ -z "$user" || "$user" =~ ^[A-Za-z0-9._@+-]+$ ]] || { log "invalid username"; return 2; }
    # the tool ends up in git's helper command line, so only plain names are accepted
    [[ "$tool" =~ ^[a-z0-9_-]{1,32}$ ]] || { log "invalid SCM_AUTH_TOOL (expected [a-z0-9_-], 1-32 chars)"; return 2; }
    helper="${SCM_AUTH_CREDENTIAL_HELPER:-$(scm_helper "$tool")}"
    command -v git &>/dev/null || { log 'missing dependency: git'; return 1; }

    request="$(printf 'protocol=https\nhost=%s\n' "$host")"
    [[ -z "$user" ]] || request+=$'\n'"username=$user"
    # the empty helper resets every configured helper (incl. oauth and url-specific ones), so
    # only the keyring is asked; prompts fail fast instead of blocking
    token="$(GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true SSH_ASKPASS='' \
        git -c credential.helper= -c "credential.helper=$helper" credential fill \
        <<<"$request" 2>/dev/null | awk '!found && sub(/^password=/, "") { print; found = 1 }')" || token=""
    [[ -n "$token" ]] || return 1
    printf '%s\n' "$token"
}

main "$@"
