# Default linux tools
# * configure color support and defaults / aliases for standard linux tools
# - shadow:     grep      =>    ugrep
# - shadow:     egrep     =>    ugrep
# - shadow:     fgrep     =>    ugrep
# - shadow:     rgrep     =>    ugrep
# - shadow:     diff      =>    vimdiff
# - replace:    colordiff =>    vimdiff
# - add:        ripgrep   =>    rg
if [[ -x /usr/bin/dircolors ]]; then
    if test -r ~/.dircolors; then
        eval "$(dircolors -b ~/.dircolors)"
    else
        eval "$(dircolors -b)"
    fi
    alias ls='ls --color=auto'
    alias dir='dir --color=auto'
    alias vdir='vdir --color=auto'
    alias grep='/usr/bin/ugrep -G -Y --no-config --color=auto'
    alias egrep='/usr/bin/ugrep -E -Y --no-config --color=auto'
    alias fgrep='/usr/bin/ugrep -F -Y --no-config --color=auto'
    alias rgrep='/usr/bin/ugrep -r -Y --no-config --color=auto'
    alias ug='/usr/bin/ug --color=auto'
    alias ugrep='/usr/bin/ugrep --hidden --color=auto'
    alias rg='/usr/bin/rg --include-zero --hyperlink-format=kitty --color=auto'
    alias ripgrep='/usr/bin/rg -uu --hyperlink-format=none --color=auto'
else
    alias grep='/usr/bin/ugrep -G -Y --no-config --hidden --color=never'
    alias egrep='/usr/bin/ugrep -E -Y --no-config --hidden --color=never'
    alias fgrep='/usr/bin/ugrep -F -Y --no-config --hidden --color=never'
    alias rgrep='/usr/bin/ugrep -r -Y --no-config --hidden --color=never'
    alias ug='/usr/bin/ug --hyperlink --color=never'
    alias ugrep='/usr/bin/ugrep --hidden --no-hyperlink --color=never'
    alias rg='/usr/bin/rg --include-zero --hyperlink-format=default --color=never'
    alias ripgrep='/usr/bin/rg -uu --hyperlink-format=none --color=never'
fi
