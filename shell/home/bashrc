# validate port is reachable

function checkport() {
    nmap "$1" -PN -p "$2" 2>/dev/null | grep "^$2" | grep -iE 'open|filtered'
}

# validate url is reachable

function checkurl() {
    local STATUS
    STATUS=$(
        curl --silent --head --location --fail -w '%{http_code}' --output /dev/null "$1"
    )

    if ((STATUS == 200)); then
        echo "valid"
    elif ((STATUS == 405)) && wget --spider "$1" 2>/dev/null; then
        echo "valid"
    else
        echo "not valid"
    fi
}

# validate passwordless ssh connections can be established (keys should be setup)

function checkssh() {
    if command ssh -q -o BatchMode=yes -o ConnectTimeout=5 "$@" 'echo' &>/dev/null; then
        echo "valid"
    else
        echo "not valid"
    fi
}

# extract any type of file

function extract() {
    local infile="$1"
    local outdir''

    if [[ ! -f "$infile" ]]; then
        echo "${FUNCNAME[0]}(): file '$infile' not found"
        return 1
    fi

    case "$infile" in
    *.tar)
        tar -xf "$infile"
        ;;
    *.tar.*)
        tar -xaf "$infile"
        ;;
    *.bz2)
        bunzip2 "$infile"
        ;;
    *.rar)
        unrar x "$infile"
        ;;
    *.gz)
        gunzip "$infile"
        ;;
    *.tbz2)
        tar xjf "$infile"
        ;;
    *.tgz)
        tar xzf "$infile"
        ;;
    *.zip)
        unzip "$infile"
        ;;
    *.crx)
        outdir="$(basename -s '.crx' "$infile")"
        mkdir -p "$outdir" || {
            echo "${FUNCNAME[0]}(): failed creating outout dir '$outdir'"
            return 1
        }
        unzip -d "$outdir" "$infile"
        ;;
    *.Z)
        uncompress "$infile"
        ;;
    *.7z)
        7z x "$infile"
        ;;
    *.deb)
        ar x "$infile"
        ;;
    *.rpm)
        rpm2cpio "$infile" | cpio -idmv
        ;;
    *.xz)
        xz --decompress "$infile"
        ;;
    *)
        echo "${FUNCNAME[0]}(): failed extracting '$infile' unsupported ext"
        return 1
        ;;
    esac

    return 0
}

function unminify() {
    local output_file=""
    local input_file=""
    local usage="Usage: unminify [-h] [-o <file>] <input_file>\n\nOptions:\n  -h, --help    Show this help message\n  -o <file>     Output to specified file (defaults to stdout if omitted)"

    # 1. Parse operational flags via manual loop
    while [[ $# -gt 0 ]]; do
        case "$1" in
        -h | --help)
            echo -e "$usage"
            return 0
            ;;
        -o | --output)
            if [[ -z "$2" || "$2" == -* ]]; then
                echo "Error: Option $1 requires an argument." >&2
                return 1
            fi
            output_file="$2"
            shift 2
            ;;
        -*)
            echo "Error: Invalid option '$1'" >&2
            echo -e "$usage" >&2
            return 1
            ;;
        *)
            if [[ -n "$input_file" ]]; then
                echo "Error: Only one input file can be specified." >&2
                return 1
            fi
            input_file="$1"
            shift
            ;;
        esac
    done

    # 2. Validate input targets
    if [[ -z "$input_file" ]]; then
        echo "Error: Missing input file path." >&2
        echo -e "$usage" >&2
        return 1
    fi

    if [[ ! -f "$input_file" ]]; then
        echo "Error: File '$input_file' not found." >&2
        return 1
    fi

    # 3. Format assets and route output stream
    case "${input_file##*.}" in
    js | json)
        if [[ -n "$output_file" ]]; then
            esbuild "$input_file" --format=esm --minify=false --outfile="$output_file"
        else
            esbuild "$input_file" --format=esm --minify=false
        fi
        ;;
    css)
        if [[ -n "$output_file" ]]; then
            esbuild "$input_file" --minify=false --outfile="$output_file"
        else
            esbuild "$input_file" --minify=false
        fi
        ;;
    html)
        if [[ -n "$output_file" ]]; then
            tidy -indent -wrap 0 -quiet "$input_file" >"$output_file"
        else
            tidy -indent -wrap 0 -quiet "$input_file"
        fi
        ;;
    xml | svg)
    # -xml tells tidy to preserve XML structures and tags flawlessly
        if [[ -n "$output_file" ]]; then
            tidy -xml -indent -wrap 0 -quiet "$input_file" >"$output_file"
        else
            tidy -xml -indent -wrap 0 -quiet "$input_file"
        fi
        ;;
    *)
        echo "Error: Unsupported file extension." >&2
        return 1
        ;;
    esac
}

# Usage:
#   randomchars [-a|-d|-g|-x] [length]
# Arguments:
#   -a:         use alphabetic character set (A-Za-z)
#   -d:         use digit character set (0-9)
#   -g:         use graph character set (printable without space)
#   -x:         use hexadecimal character set (0-9a-fA-F)
#   length:     number of characters to generate (default 32)
# Defaults:
#   charset:    alphanumeric character set (A-Za-z0-9)

function randomchars() {
    local charset
    local -i len
    local -i blkmult


    case "$1" in
    -a)
        charset='[:alpha:]'
        blkmult=24
        shift
        ;;
    -d)
        charset='[:digit:]'
        blkmult=32
        shift
        ;;
    -g)
        charset='[:graph:]'
        blkmult=16
        shift
        ;;
    -x)
        charset='[:xdigit:]'
        blkmult=16
        shift
        ;;
    *)
        charset='[:alnum:]'
        blkmult=16
        ;;
    esac

    if [[ -n "$1" ]]; then
        [[ "$1" =~ ^[0-9]+$ ]] || {
            echo "Usage: randomchars [-a|-d|-g|-x] [length]" >&2
            return 1
        }

        len="$1"
        shift
    else
        len=32
    fi

    dd if=/dev/urandom bs=$((len * blkmult)) count=1 2>/dev/null |
        tr -dc "$charset" |
        head -c "$len" &&
        printf '\n'
    return 0
}

# $1 == prefix for each arg
# $2 == delimiter between args
# $3 == suffix for each arg
# $@ == args to join (optional, if missing reads from stdin)

function joinwith() {
    local start="$1"
    local sep="$2"
    local end="$3"
    local IFS
    local -a args
    shift 3

    if (($# > 0)); then
        args=("$@")
    elif [[ ! -t 0 ]]; then
        mapfile -t args
    fi

    if ((${#args[@]} == 0)); then
        return 0
    fi

    IFS=''
    echo -n "$start${args[0]}$end"

    if ((${#args[@]} > 1)); then
        printf "${sep}${start}%s${end}" "${args[@]:1}"
    fi

    return 0
}

# get terminal title

function gtitle() {
    echo "$TERM_TITLE"
}

# change terminal title

# shellcheck disable=SC2119,SC2120

function ctitle() {
    local _s

    if [[ -n "$1" ]]; then
        _s="$1"
    elif [[ ! -t 0 ]]; then
        _s="$(</dev/stdin)"
    else
        return 1
    fi

    printf '\e]2;%s\a' "$_s"
    export TERM_TITLE="$_s"
}

# change current terminal profile
# Usage: cprofile <profile number>
# TODO: this was only tested on gnome-terminal

function cprofile() {
    xdotool key --delay 0 --clearmodifiers Shift+F10 r "$1"
}

