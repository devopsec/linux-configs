#=============================================================================================
# Shell Helper Functions
#=============================================================================================

# Same rules as the ~/.profile __shell_path_* helpers: entries must be absolute and free of
# ":", trailing slashes are dropped and "dir/" counts as "dir". bash variables are dynamically
# scoped, so these update the caller's "local -x PATH" when it has one.

# Succeed when "$1" can be a PATH entry; warn on stderr otherwise. A value with
# non-printable characters is not printed, so it cannot send escape sequences to the terminal.
function __bash_path_valid() {
    local reason shown="'$1'"
    case "$1" in
        '')  reason='empty' ;;
        *:*) reason='contains ":"' ;;
        /*)  return 0 ;;
        *)   reason='not an absolute path' ;;
    esac
    [[ "$1" == *[![:print:]]* ]] && shown='<has non-printable characters>'
    printf '%s: skipping PATH entry %s: %s\n' "${FUNCNAME[1]}" "$shown" "$reason" >&2
    return 1
}

# Put "$1" first in PATH, moving it there if it is already present
function __bash_path_prepend() {
    __bash_path_valid "${1-}" || return
    local dir="$1" rest=":${PATH-}:"
    while [[ "$dir" == ?*/ ]]; do dir="${dir%/}"; done
    # repeated: one pass skips the second of two adjacent copies (":dir:dir:")
    while [[ "$rest" == *":$dir:"* || "$rest" == *":$dir/:"* ]]; do
        rest="${rest//":$dir:"/:}"
        rest="${rest//":$dir/:"/:}"
    done
    rest="${rest#:}"
    rest="${rest%:}"
    PATH="$dir${rest:+:$rest}"
}

# Add "$1" last in PATH, unless it is already present anywhere
function __bash_path_append() {
    __bash_path_valid "${1-}" || return
    local dir="$1"
    while [[ "$dir" == ?*/ ]]; do dir="${dir%/}"; done
    [[ ":${PATH-}:" == *":$dir:"* || ":${PATH-}:" == *":$dir/:"* ]] || PATH="${PATH:+$PATH:}$dir"
}

#=============================================================================================
# Pager / Docs Tools
#=============================================================================================

# Texinfo manuals open in nvimpager (info.nvim) and manpage-only topics in man; options, more
# than two arguments or output that is not a terminal go to the real info
function info() {
    local where IFS=' '
    local -a topic
    if [[ -t 1 ]] && (( $# > 0 && $# <= 2 )) && [[ "$1" != -* ]]; then
        where="$(command info --where "$@" 2>/dev/null)"
        if [[ "$where" == '*manpages*' ]]; then
            man "$1"
            return
        elif [[ -n "$where" ]]; then
            # backslashes and spaces escaped for the :Info command line
            topic=("${@//\\/\\\\}")
            topic=("${topic[@]// /\\ }")
            nvimpager -p -- -c "Info ${topic[*]}" -c only
            return
        fi
    fi
    command info "$@"
}

