# precomupted colors
__C_RESET="\[$(tput sgr0)\]"
__C_RED="\[$(tput setaf 1)\]"
__C_GREEN="\[$(tput setaf 2)\]"
__C_YELLOW="\[$(tput setaf 3)\]"
__C_BLUE="\[$(tput setaf 4)\]"
__C_MAGENTA="\[$(tput setaf 5)\]"
__C_WHITE="\[$(tput setaf 7)\]"

declare -A __bash_next_ps1=(
    ['user']='__bash_git_ps1'
    ['git']='__bash_user_ps1'
)
__bash_curr_ps1='user'

function __bash_user_ps1() {
    __bash_curr_ps1='user'
    PS1="${__C_RED}[${__C_YELLOW}\u${__C_GREEN}@${__C_BLUE}\h ${__C_MAGENTA}\w${__C_RED}]${__C_WHITE}${__C_RESET} "
}

# fetch and parse git repo info
# NOTE: async is an external dependency (from ~/scripts/)
# TODO: add support for displaying branch info when interatively rebasing

function __bash_git_ps1() {
    __bash_curr_ps1='git'

    local PROJECT_DIR
    PROJECT_DIR=$(command git rev-parse --show-toplevel 2>/dev/null) || {
        PS1="${__C_RED}[${__C_GREEN}\w ${__C_YELLOW}<invalid>${__C_RED}]${__C_RESET} "
        return
    }

    # Trigger background fetch if stale — no -t flag so fetch always runs to completion
    local FETCH_HEAD="$PROJECT_DIR/.git/FETCH_HEAD"
    local LAST_FETCH
    LAST_FETCH=$(stat -c %Y "$FETCH_HEAD" 2>/dev/null || echo 0)
    if (($(date +%s) - LAST_FETCH > 600)); then
        async -q git -C "$PROJECT_DIR" fetch -q --recurse-submodules=no
    fi

    local RELEASE_TAG PUSH_DST
    RELEASE_TAG=$(command git describe --tags --abbrev=0 2>/dev/null)
    PUSH_DST=$(command git rev-parse --abbrev-ref '@{push}' 2>/dev/null)

    local LOCAL_BRANCH='' REMOTE_BRANCH='' REPO_STATE=''
    local ab_ahead=0 ab_behind=0
    local s_modified=0 s_untracked=0 s_new=0 s_renamed=0 s_deleted=0

    # Single git call replaces: git branch --show-current, git rev-parse @{push},
    # git status, and 8x (echo|grep) — eliminating ~18 process forks per prompt
    local STATUS_OUT
    STATUS_OUT=$(command git status --porcelain=v2 --branch --ignore-submodules 2>/dev/null)

    while IFS= read -r line; do
        case "$line" in
        '# branch.head '*)
            LOCAL_BRANCH="${line#'# branch.head '}"
            ;;
        '# branch.upstream '*)
            REMOTE_BRANCH="${line#'# branch.upstream '}"
            ;;
        '# branch.ab '*)
            local _ab="${line#'# branch.ab '}"
            ab_ahead="${_ab% *}"
            ab_ahead="${ab_ahead#+}"
            ab_behind="${_ab#* }"
            ab_behind="${ab_behind#-}"
            ;;
        '1 '*) # ordinary changed entries — XY flags at positions 2-3
            local _xy="${line:2:2}"
            [[ "$_xy" == *[Mm]* ]] && s_modified=1
            [[ "$_xy" == *[Dd]* ]] && s_deleted=1
            [[ "$_xy" == *[Aa]* ]] && s_new=1
            ;;
        '2 '*) s_renamed=1 ;; # renamed/copied entry
        '? '*) s_untracked=1 ;; # untracked file
        esac
    done <<<"$STATUS_OUT"

    ((s_modified)) && REPO_STATE+='!'
    ((s_untracked)) && REPO_STATE+='?'
    ((s_new)) && REPO_STATE+='+'
    ((s_renamed)) && REPO_STATE+='>'
    ((s_deleted)) && REPO_STATE+='x'
    ((ab_behind)) && REPO_STATE+='&'
    ((ab_ahead)) && REPO_STATE+='*'
    ((ab_ahead && ab_behind)) && REPO_STATE+='☠'
    [[ -z "$PUSH_DST" ]] && REPO_STATE+='⬆'

    local _tag='' _state=''
    [[ -n "$RELEASE_TAG" ]] && _tag=" ${__C_MAGENTA}${RELEASE_TAG}"
    [[ -n "$REPO_STATE" ]] && _state=" ${__C_YELLOW}${REPO_STATE}"
    PS1="${__C_RED}(${__C_GREEN}$(basename "$PROJECT_DIR")${__C_RED})["
    if [[ "$LOCAL_BRANCH" == '(detached)' ]]; then
        PS1+="${__C_YELLOW}<detached>${_tag}${__C_RED}]${__C_RESET} "
    elif [[ -z "$REMOTE_BRANCH" ]]; then
        PS1+="${__C_BLUE}${LOCAL_BRANCH}${_tag}${_state}${__C_RED}]${__C_RESET} "
    else
        PS1+="${__C_BLUE}${LOCAL_BRANCH}...${REMOTE_BRANCH}${_tag}${_state}${__C_RED}]${__C_RESET} "
    fi
}

function __bash_set_ps1() {
    if [[ -d '.git/' ]]; then
        __bash_git_ps1
    else
        __bash_user_ps1
    fi
}

function toggleps1() {
    PROMPT_COMMAND="${__bash_next_ps1[$__bash_curr_ps1]}"
}

function resetps1() {
    PROMPT_COMMAND='__bash_set_ps1'
}

