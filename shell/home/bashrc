# update the resolution of a serial/tty session

function tty-resize() {
    local old rows cols
    old=$(stty -g)
    stty raw -echo min 0 time 5
    printf '\0337\033[r\033[999;999H\033[6n\0338' >/dev/tty
    IFS='[;R' read -r _ rows cols _ </dev/tty
    stty "$old"
    stty cols "$cols" rows "$rows"
}

# send an alert with the status of the last command

function alert() {
    local _rc=$?
    local _cmd
    _cmd=$(
        fc -lnr 0 -0 | awk -v fn="${FUNCNAME[0]}" '
            NR == 1 {
                gsub(/^[[:space:]]+|[[:space:]]+$/, _);
                if ($0 == fn) { next; }
                { print; exit; }
            }
            NR == 2 {
                gsub(/^[[:space:]]+|[[:space:]]+$/, _);
                { print; exit; }
            }
        '
    )
    if ((_rc == 0)); then
        notify-send --urgency=low \
            -i terminal \
            -a "$(gtitle)   ✅✅" \
            "$_cmd"
    else
        notify-send --urgency=low \
            -i terminal \
            -a "$(gtitle)   ☠☠" \
            "$_cmd"
    fi
}

# get a pseudo-random city name seeded by PPID
# child terminals of this emulator will return the same value
# NOTE: depends on city-names dictionary
function gtermgroup() {
    shuf -n 1 --random-source=<(
        RANDOM=$PPID
        while :; do
            printf '%08x' $(((RANDOM << 15) | RANDOM))
        done
    ) "$HOME/.local/share/dict/city-names"
}


