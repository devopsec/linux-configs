#=============================================================================================
# Shell Specific Settings
#=============================================================================================
# bash requires explicit sourcing of its rc config in interactive mode
# ksh sources $ENV itself in interactive shells, right after this file in login shells
# zsh uses ~/.zprofile instead, thereforce omitted below

# the branch whose *_VERSION is set expands to 1 and matches
# shellcheck disable=SC2194
case 1 in
"${BASH_VERSION:+1}")
    if [ -f "$HOME/.bashrc" ]; then
        # bash code, named bashrc in the repo: shellcheck checks it on its own
        # shellcheck source=/dev/null
        . "$HOME/.bashrc"
    fi
    ;;
"${KSH_VERSION:+1}")
    if [ -f "$HOME/.kshrc" ]; then
        export ENV="$HOME/.kshrc"
    fi
    ;;
esac

